{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "erasableSyntaxOnly": true,
    "allowJs": true,
    "checkJs": true
  },
  "include": ["bin/**/*.js", "scripts/**/*.ts", "src/**/*.ts", "tests/**/*.ts"]
}
